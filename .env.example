# ── Environment Variables ──────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Google AI Studio (Gemini)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_jwt_token_here

# Optional: OpenRouter fallback (not used in Phase 1)
OPENROUTER_API_KEY=

# ── Application Tuning (all have safe defaults) ───────────────────────────
# Cosine distance cutoff — queries with distance > this are refused with 0 LLM tokens
YTRAG_MAX_DISTANCE=0.5

# Chunking window size in seconds
YTRAG_CHUNK_SECONDS=75

# Overlap between consecutive windows in seconds
YTRAG_CHUNK_OVERLAP=15

# Player rewind before chunk start (for context lead-in)
YTRAG_LINK_REWIND=5

# Qdrant collection name
YTRAG_COLLECTION=dsa_lectures_1024

# Embedding model (must produce 1024-dim vectors)
YTRAG_EMBED_MODEL=BAAI/bge-m3

# Gemini model ID
YTRAG_GEMINI_MODEL=gemini-2.5-flash

# Max LLM output tokens (strict cap)
YTRAG_MAX_OUTPUT_TOKENS=350
